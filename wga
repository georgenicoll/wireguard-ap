#!/usr/bin/env bash
# Thin wrapper around tofu that injects the external config file, so that
# day-to-day use is:
#
#   ./wga init
#   ./wga plan
#   ./wga apply
#   ./wga output
#   ./wga destroy
#
# Configuration:
#   WGA_CONFIG     path to your private wireguard-ap.tfvars file (required for
#                  plan/apply/destroy/refresh/import/console) - see
#                  wireguard-ap.example.tfvars.
#   WGA_STATE_DIR  optional directory to keep state in, instead of this repo.
#                  State contains the Wi-Fi PSK, so a private, backed-up
#                  location is sensible.
#   WGR_REPO_DIR   path to a wireguard-router checkout, used to fetch the
#                  WireGuard client config named by wireguard_client_name in
#                  your tfvars (via its scripts/wg-peer.sh). Defaults to
#                  ../wireguard-router next to this repo. Only needed when
#                  wireguard_client_name is set.
#   WGR_CONFIG /   wireguard-router's own env vars, needed for the above -
#   WGR_KEYS       see wireguard-router's README. Typically already set by
#                  sourcing whatever environment script you use for that repo.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat >&2 <<USAGE
Usage: ./wga <tofu-command> [args...]

Examples:
  ./wga init
  ./wga plan
  ./wga apply
  ./wga output -raw ssh_hint
  ./wga destroy
USAGE
    exit 2
}

[[ $# -lt 1 ]] && usage

COMMAND="$1"; shift

command -v tofu >/dev/null 2>&1 || {
    echo "error: 'tofu' is not on PATH. See https://opentofu.org/docs/intro/install/" >&2
    exit 1
}

# The ascii submodule (login banner art) is read by main.tf's locals, so it's
# needed for nearly every tofu command, not just apply. Auto-fetch it if it
# hasn't been checked out yet, so nobody has to remember `git submodule
# update --init` themselves.
if [[ ! -s "$REPO_DIR/ascii/monkeynuthead.txt" ]]; then
    echo "wga: fetching the ascii submodule..." >&2
    git -C "$REPO_DIR" submodule update --init
fi

ARGS=()

# Commands that consume variables need the external config file.
case "$COMMAND" in
plan | apply | destroy | refresh | import | console)
    if [[ -z "${WGA_CONFIG:-}" ]]; then
        cat >&2 <<MSG
error: WGA_CONFIG is not set.

Point it at your private config file, for example:
  cp wireguard-ap.example.tfvars ~/private/wireguard-ap.tfvars
  export WGA_CONFIG=~/private/wireguard-ap.tfvars
MSG
        exit 1
    fi
    CONFIG_PATH="$(cd "$(dirname "$WGA_CONFIG")" && pwd)/$(basename "$WGA_CONFIG")"
    if [[ ! -r "$CONFIG_PATH" ]]; then
        echo "error: cannot read config file: $CONFIG_PATH" >&2
        exit 1
    fi
    # Absolute, because -chdir changes how relative paths resolve.
    ARGS+=("-var-file=$CONFIG_PATH")

    # wireguard_client_name in the tfvars picks which wireguard-router peer
    # this Pi uses. Fetch that peer's client config fresh on every run -
    # never written to disk here - via wireguard-router's own
    # scripts/wg-peer.sh, rather than duplicating its key-management logic
    # in this repo. Required in variables.tf, so it should always be
    # present; if it's genuinely absent, tofu's own validation will say so.
    CLIENT_NAME="$(sed -nE 's/^[[:space:]]*wireguard_client_name[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' "$CONFIG_PATH" | tail -1)"
    if [[ -n "$CLIENT_NAME" ]]; then
        WGR_REPO_DIR="${WGR_REPO_DIR:-$REPO_DIR/../wireguard-router}"
        WG_PEER_SCRIPT="$WGR_REPO_DIR/scripts/wg-peer.sh"
        if [[ ! -x "$WG_PEER_SCRIPT" ]]; then
            cat >&2 <<MSG
error: cannot find wireguard-router's scripts/wg-peer.sh at:
  $WG_PEER_SCRIPT

Set WGR_REPO_DIR to your wireguard-router checkout, e.g.:
  export WGR_REPO_DIR=~/code/wireguard-router
MSG
            exit 1
        fi
        if [[ -z "${WGR_CONFIG:-}" && -z "${WGR_KEYS:-}" ]]; then
            cat >&2 <<MSG
error: WGR_CONFIG or WGR_KEYS must be set to fetch the '$CLIENT_NAME' client
config from wireguard-router's key store. These are wireguard-router's own
env vars (see its README) - typically already set by sourcing whatever
environment script you use for that repo, alongside WGA_CONFIG.
MSG
            exit 1
        fi
        TF_VAR_wireguard_client_config="$("$WG_PEER_SCRIPT" client "$CLIENT_NAME")"
        export TF_VAR_wireguard_client_config
    fi
    ;;
esac

# Optional external state location.
if [[ -n "${WGA_STATE_DIR:-}" ]]; then
    mkdir -p "$WGA_STATE_DIR"
    STATE_DIR_ABS="$(cd "$WGA_STATE_DIR" && pwd)"
    case "$COMMAND" in
    plan | apply | destroy | refresh | import | output | show | state | taint | untaint)
        ARGS+=("-state=$STATE_DIR_ABS/wireguard-ap.tfstate")
        ;;
    esac
fi

set -x
exec tofu -chdir="$REPO_DIR" "$COMMAND" "${ARGS[@]}" "$@"
